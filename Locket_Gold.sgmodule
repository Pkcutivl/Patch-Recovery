#!name=Locket Gold VIP
#!desc=Locket Gold Clean Entitlements (Zero external API, No crash)

[MITM]
hostname = %APPEND% api.revenuecat.com

[Script]
LocketRequest = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/Pkcutivl/Patch-Recovery/locket/Locket_clean.js, timeout=10

LocketResponse = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/Pkcutivl/Patch-Recovery/locket/Locket_clean.js, requires-body=1, max-size=0, timeout=10
